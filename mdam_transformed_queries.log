-- Test Case: MDAM Paper General OR Example
-- Transformed Query (8 retrievals):
SELECT *
FROM (/* Retrieval # 1 */
        (SELECT dept, sdate, item_class, store
         FROM sales_mdam_paper
         WHERE dept < 2
           AND sdate = '1995-06-04'
           AND item_class = 10)
      UNION ALL /* Retrieval # 2 */
        (SELECT dept, sdate, item_class, store
         FROM sales_mdam_paper
         WHERE dept = 2
           AND item_class IN (5, 10))
      UNION ALL /* Retrieval # 3 */
        (SELECT dept, sdate, item_class, store
         FROM sales_mdam_paper
         WHERE dept > 2
           AND dept < 4
           AND sdate = '1995-06-04'
           AND item_class = 10)
      UNION ALL /* Retrieval # 4 */
        (SELECT dept, sdate, item_class, store
         FROM sales_mdam_paper
         WHERE dept = 4
           AND sdate < '1995-06-04'
           AND item_class = 5)
      UNION ALL /* Retrieval # 5 */
        (SELECT dept, sdate, item_class, store
         FROM sales_mdam_paper
         WHERE dept = 4
           AND sdate = '1995-06-04'
           AND item_class IN (5, 10))
      UNION ALL /* Retrieval # 6 */
        (SELECT dept, sdate, item_class, store
         FROM sales_mdam_paper
         WHERE dept = 4
           AND sdate > '1995-06-04'
           AND item_class = 5)
      UNION ALL /* Retrieval # 7 */
        (SELECT dept, sdate, item_class, store
         FROM sales_mdam_paper
         WHERE dept = 5
           AND sdate = '1995-06-04'
           AND item_class IN (5, 10))
      UNION ALL /* Retrieval # 8 */
        (SELECT dept, sdate, item_class, store
         FROM sales_mdam_paper
         WHERE dept > 5
           AND sdate = '1995-06-04'
           AND item_class = 10)) AS mdam_subquery;

