-- This needs to put the "=" condition on both a and b first, then put the
-- inequalities after that, without marking the inequalities as required
select
  *
from
  fuzz_skip_scan
where
a = 1 and a > 1 and
b > 1 and b =1
order by
  a desc NULLS last,
  b desc NULLS last,
  c desc NULLS last,
  d desc NULLS last
limit 1;
