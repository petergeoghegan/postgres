-- Here we seem to be including non-required mark inequalities on "b", should
-- be plain inequalities marked required but with no redundancy (so 1 "b"
-- key comes at the very end and isn't marked required):
select
  *
from
  fuzz_skip_scan
where
  b >= 14
  and b > 5
  and a < 12
  and a <= 9
order by
  a desc,
  b desc,
  c desc,
  d desc
limit 1;
