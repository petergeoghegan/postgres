                        so->keyData[1]: [ strategy: >=, attno: 2/"b", func: int4ge, flags: [SK_BT_REQBKWD] ]
                        so->keyData[2]: [ strategy: = , attno: 2/"b", func: int4eq, flags: [SK_SEARCHARRAY, SK_BT_REQFWD, SK_BT_REQBKWD, SK_BT_SKIP] ]
