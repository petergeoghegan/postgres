-- Test >= RowCompare
prepare test_rowcompare as
select count(*), district, warehouse, orderid
from redescend_test
where district in (1, 2, 3) and (warehouse, orderid) >= (5, 149)
group by district, warehouse, orderid
order by district, warehouse, orderid;
