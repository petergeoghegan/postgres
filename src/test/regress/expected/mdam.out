--
-- Ordering check must reject an Append where two retrievals both emit
-- rows with a IS NULL.
--
--   ((a = 84 AND b >= 137 AND c IN (12, 32, 40))
--    OR b > 92
--    OR (a IS NULL AND b < 80))
--
-- After merging, arm 1 is absorbed into arm 2's b > 92, leaving:
--   R1: b > 92               -- no a constraint, scans NULL a too
--   R2: a IS NULL AND b < 80
--
-- Both produce rows with a IS NULL: R1 emits them at the end of its scan
-- (NULLS LAST under ASC), R2 emits only NULL-a rows.  An Append
-- concatenates R1 || R2, so R1's NULL-a rows (b > 92) come before R2's
-- (b < 80) -- a violation of ORDER BY a, b, c, d.  MDAM must reject the
-- Append shape; whichever plan wins instead must still respect the
-- requested ordering.
--
CREATE TABLE mdam_order_bug_tbl (a int, b int, c int, d int);
INSERT INTO mdam_order_bug_tbl
SELECT NULLIF((i*7+13) % 100, 0), NULLIF((i*11+3) % 200, 0),
       NULLIF((i*5+17) % 50, 0),  NULLIF((i*3+7) % 25, 0)
FROM generate_series(1, 20000) i;
CREATE INDEX mdam_order_bug_idx ON mdam_order_bug_tbl (a, b, c, d);
ANALYZE mdam_order_bug_tbl;
-- Lower random_page_cost so MDAM wins the cost race at this row count;
-- under regression defaults the planner otherwise picks an Index Only
-- Scan + Filter and the ordering-check path is never exercised.
SET random_page_cost = 2;
SET enable_indexscan = on;
SET enable_indexonlyscan = on;
SET enable_sort = off;
-- Plan shape: MDAM rejects the Append (R1/R2 share the NULL-a partition),
-- so the planner falls back to a single Index Only Scan with Filter.
EXPLAIN (COSTS OFF)
SELECT a, b, c, d FROM mdam_order_bug_tbl
WHERE ((a = 84 AND b >= 137 AND c IN (12, 32, 40))
       OR b > 92
       OR (a IS NULL AND b < 80))
ORDER BY a, b, c, d;
                                                       QUERY PLAN                                                        
-------------------------------------------------------------------------------------------------------------------------
 Index Only Scan using mdam_order_bug_idx on mdam_order_bug_tbl
   Filter: (((a = 84) AND (b >= 137) AND (c = ANY ('{12,32,40}'::integer[]))) OR (b > 92) OR ((a IS NULL) AND (b < 80)))
(2 rows)

-- Ordering check: position 10601 is the first row with a IS NULL.  A
-- correctly-ordered result puts (NULL, 54, 22, 5) here -- the smallest b
-- among NULL-a rows.  Any plan whose output interleaves NULL-a rows from
-- the two predicate components would emit a larger b at this position.
SELECT a, b, c, d FROM mdam_order_bug_tbl
WHERE ((a = 84 AND b >= 137 AND c IN (12, 32, 40))
       OR b > 92
       OR (a IS NULL AND b < 80))
ORDER BY a, b, c, d
LIMIT 1 OFFSET 10600;
 a | b  | c  | d 
---+----+----+---
   | 54 | 22 | 5
(1 row)

DROP TABLE mdam_order_bug_tbl;
RESET enable_sort;
RESET enable_indexscan;
RESET enable_indexonlyscan;
RESET random_page_cost;
--
-- Trailing-column disjoint values must survive shattering as discrete
-- atoms, not collapse to their hull.  When a top-level AND combines two
-- OR branches that each constrain the same trailing column (here d),
-- the cross-product expansion can produce a sub-path whose d atoms are
-- two disjoint equalities (d = 446 and d = 804); these must appear in
-- the Index Cond as d = ANY ('{446, 804}'), not as d BETWEEN 446 AND 804
-- (which would admit rows strictly between the endpoints).
--
--   (d = 446 OR (a = 4 AND d = 804))
--   AND (b = 7 OR (b <= 16 AND d IN (758, 882)))
--
-- Exactly one row in the data below satisfies the predicate:
-- (a, b, c, d) = (2, 7, 29, 446).
--
CREATE TABLE mdam_inlist_bug_tbl (a int, b int, c int, d int);
INSERT INTO mdam_inlist_bug_tbl
SELECT (i % 9) + 1, (i % 49) + 1, (i % 199) + 1, ((i * 31) % 999) + 1
FROM generate_series(1, 5000) i;
CREATE INDEX mdam_inlist_bug_idx ON mdam_inlist_bug_tbl (a, b, c, d);
ANALYZE mdam_inlist_bug_tbl;
EXPLAIN (COSTS OFF)
SELECT count(*) AS actual FROM mdam_inlist_bug_tbl
WHERE (d = 446 OR (a = 4 AND d = 804))
  AND (b = 7 OR (b <= 16 AND d IN (758, 882)));
                                       QUERY PLAN                                       
----------------------------------------------------------------------------------------
 Aggregate
   ->  Append
         ->  Index Only Scan using mdam_inlist_bug_idx on mdam_inlist_bug_tbl
               Index Cond: ((a < 4) AND (b = 7) AND (d = 446))
         ->  Index Only Scan using mdam_inlist_bug_idx on mdam_inlist_bug_tbl
               Index Cond: ((a = 4) AND (b = 7) AND (d = ANY ('{446,804}'::integer[])))
         ->  Index Only Scan using mdam_inlist_bug_idx on mdam_inlist_bug_tbl
               Index Cond: ((a > 4) AND (b = 7) AND (d = 446))
         ->  Index Only Scan using mdam_inlist_bug_idx on mdam_inlist_bug_tbl
               Index Cond: ((a IS NULL) AND (b = 7) AND (d = 446))
(10 rows)

SELECT count(*) AS actual FROM mdam_inlist_bug_tbl
WHERE (d = 446 OR (a = 4 AND d = 804))
  AND (b = 7 OR (b <= 16 AND d IN (758, 882)));
 actual 
--------
      1
(1 row)

SELECT a, b, c, d FROM mdam_inlist_bug_tbl
WHERE (d = 446 OR (a = 4 AND d = 804))
  AND (b = 7 OR (b <= 16 AND d IN (758, 882)))
ORDER BY a, b, c, d;
 a | b | c  |  d  
---+---+----+-----
 2 | 7 | 29 | 446
(1 row)

DROP TABLE mdam_inlist_bug_tbl;
--
-- Contradictory atoms (x = 1 vs. x IS NULL) inside an OR-containing-AND
-- with a trailing-column (y) reference must complete planning cleanly,
-- with the contradictory branch dropped and the surviving disjunct
-- (y = 'q') driving the index scan.
--
CREATE TABLE mdam_crash_mixed (x integer, y text);
CREATE INDEX mdam_crash_mixed_xy ON mdam_crash_mixed USING btree (x, y);
EXPLAIN (COSTS OFF)
SELECT 1 FROM mdam_crash_mixed
WHERE x = 1 AND (x IS NULL AND (y < 'a' OR y IS NOT NULL) OR y = 'q');
                          QUERY PLAN                           
---------------------------------------------------------------
 Index Only Scan using mdam_crash_mixed_xy on mdam_crash_mixed
   Index Cond: ((x = 1) AND (y = 'q'::text))
(2 rows)

DROP TABLE mdam_crash_mixed;
--
-- NOT IN transformation
--
-- NOT IN (v1, v2, ..., vN) is "x <> ALL (array)" -- ScalarArrayOpExpr with
-- useOr = false.  MDAM expands it into the OR of inequality ranges
--   (x < v[0]) OR (v[0] < x < v[1]) OR ... OR (v[N-1] < x)
-- so the downstream pipeline can shatter, merge, and combine the disjuncts
-- with predicates on later index columns.  The motivating case is
-- "WHERE foo NOT IN (...) AND bar = X" on an (foo, bar) index when foo
-- has relatively few distinct values; modulo cost-based path selection
-- this becomes an Append of IndexOnlyScans, each carrying bar = X as part
-- of its Index Cond rather than as a per-row filter.
--
-- The tests below force the Append shape with a bounding BETWEEN on the
-- leading column.  Bounding turns the outer arms (x < v[0], x > v[N-1])
-- into finite ranges so MDAM's per-arm scan costs stay competitive with
-- the plain index scan + filter alternative, independent of catalog state.
-- Motivating shape: bounded leading column + NOT IN + equality on later
-- column.  Each Append child should combine the a range with b = 5 as
-- its Index Cond.
EXPLAIN (COSTS OFF)
SELECT count(*) FROM mdam_test_tbl
WHERE a BETWEEN 10 AND 16 AND a NOT IN (12, 14) AND b = 5;
                              QUERY PLAN                              
----------------------------------------------------------------------
 Aggregate
   ->  Append
         ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
               Index Cond: ((a >= 10) AND (a < 12) AND (b = 5))
         ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
               Index Cond: ((a > 12) AND (a < 14) AND (b = 5))
         ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
               Index Cond: ((a > 14) AND (a <= 16) AND (b = 5))
(8 rows)

SELECT count(*) FROM mdam_test_tbl
WHERE a BETWEEN 10 AND 16 AND a NOT IN (12, 14) AND b = 5;
 count 
-------
    50
(1 row)

SET enable_mdam = off;
SELECT count(*) FROM mdam_test_tbl
WHERE a BETWEEN 10 AND 16 AND a NOT IN (12, 14) AND b = 5;
 count 
-------
    50
(1 row)

RESET enable_mdam;
-- Duplicate values in the array are deduped before the DNF is built; the
-- Append must have the same three arms as NOT IN (12, 14).
EXPLAIN (COSTS OFF)
SELECT count(*) FROM mdam_test_tbl
WHERE a BETWEEN 10 AND 16 AND a NOT IN (12, 12, 14, 14) AND b = 5;
                              QUERY PLAN                              
----------------------------------------------------------------------
 Aggregate
   ->  Append
         ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
               Index Cond: ((a >= 10) AND (a < 12) AND (b = 5))
         ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
               Index Cond: ((a > 12) AND (a < 14) AND (b = 5))
         ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
               Index Cond: ((a > 14) AND (a <= 16) AND (b = 5))
(8 rows)

SELECT count(*) FROM mdam_test_tbl
WHERE a BETWEEN 10 AND 16 AND a NOT IN (12, 12, 14, 14) AND b = 5;
 count 
-------
    50
(1 row)

-- NULL in the array makes the predicate unsatisfiable.  MDAM bails out so
-- the executor evaluates the NOT IN as a filter that rejects every row.
-- Pairing with the NOT IN (12, 14) Append above: switching to a NULL-in-
-- array form here loses the Append shape, which demonstrates that the
-- helper rejects NULL rather than silently expanding it.
--
-- FIXME: the cleaner outcome is a One-Time Filter: false Result with ~0
-- cost (same way "k NOT IN (k1, NULL, k2)" is already folded for constant
-- LHS).  That would require a planner-level pass that folds
-- "var <> ALL (array containing NULL)" to constant FALSE in
-- eval_const_expressions; out of scope for the MDAM NOT IN patch, but the
-- full-scan + filter plan below is suboptimal until it lands.
EXPLAIN (COSTS OFF)
SELECT count(*) FROM mdam_test_tbl
WHERE a BETWEEN 10 AND 16 AND a NOT IN (12, NULL, 14) AND b = 5;
                           QUERY PLAN                           
----------------------------------------------------------------
 Aggregate
   ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
         Index Cond: ((a >= 10) AND (a <= 16) AND (b = 5))
         Filter: (a <> ALL ('{12,NULL,14}'::integer[]))
(4 rows)

SELECT count(*) FROM mdam_test_tbl
WHERE a BETWEEN 10 AND 16 AND a NOT IN (12, NULL, 14) AND b = 5;
 count 
-------
     0
(1 row)

-- Cleanup
RESET enable_seqscan;
RESET enable_bitmapscan;
RESET max_parallel_workers_per_gather;
RESET enable_mdam;
DROP TABLE mdam_test_tbl;
