-- Negative case: unindexable predicate buried INSIDE an OR arm.
-- MDAM cannot drop the predicate (would lose rows), so it must bail out
-- on this index entirely and let some other path handle the query.
EXPLAIN (COSTS OFF)
SELECT a, b, c FROM mdam_filter_tbl
WHERE (a = 5 AND total > 50000) OR (a = 10 AND b = 20);
                              QUERY PLAN                              
----------------------------------------------------------------------
 Bitmap Heap Scan on mdam_filter_tbl
   Disabled: true
   Recheck Cond: ((a = 5) OR ((a = 10) AND (b = 20)))
   Filter: (((a = 5) AND (total > 50000)) OR ((a = 10) AND (b = 20)))
   ->  BitmapOr
         ->  Bitmap Index Scan on mdam_filter_tbl_idx
               Index Cond: (a = 5)
         ->  Bitmap Index Scan on mdam_filter_tbl_idx
               Index Cond: ((a = 10) AND (b = 20))
(9 rows)

DROP TABLE mdam_filter_tbl;
--
-- Cross-product contradiction: outer ANDed predicate contradicts one OR
-- arm.  Mirrors the MDAM-paper shape: two OR arms differing on the
-- leading index column, plus an outer ANDed equality on a middle index
-- column that contradicts a value in the first arm.  Skip-scan can't
-- factor here because dept differs across arms.
--   ((dept=1 AND sdate=D1 AND item_class=4) OR (dept=50 AND sdate=D2))
--     AND item_class=5
-- After distributing AND over OR:
--   arm 1: dept=1  AND sdate=D1 AND item_class=4 AND item_class=5  -- contradictory
--   arm 2: dept=50 AND sdate=D2 AND item_class=5                   -- consistent
-- The contradictory arm is kept in the DNF.  Critically, the merge step
-- preserves the contradictory column atoms (item_class=4 AND item_class=5)
-- as real index quals on the IndexScan, instead of dropping them and
-- letting only item_class=5 survive as a per-branch Filter (which would
-- scan thousands of unnecessary index entries for the dept=1 prefix).
-- nbtree's _bt_preprocess_keys detects the inconsistency at runtime.
--
CREATE TABLE mdam_paper_tbl (dept int, sdate date, item_class int, store int);
INSERT INTO mdam_paper_tbl
  SELECT (i % 100) + 1,
         '1995-01-01'::date + ((i / 100) % 400),
         (i % 75) + 1,
         (i % 300) + 1
  FROM generate_series(1, 200000) i;
CREATE INDEX mdam_paper_idx ON mdam_paper_tbl(dept, sdate, item_class, store);
ANALYZE mdam_paper_tbl;
EXPLAIN (COSTS OFF)
SELECT dept, sdate, item_class, store FROM mdam_paper_tbl
WHERE ((dept = 1 AND sdate = '1995-03-04' AND item_class = 4)
    OR (dept = 50 AND sdate = '1995-09-04'))
  AND item_class = 5;
                                    QUERY PLAN                                     
-----------------------------------------------------------------------------------
 Index Only Scan using mdam_paper_idx on mdam_paper_tbl
   Index Cond: ((dept = 50) AND (sdate = '09-04-1995'::date) AND (item_class = 5))
(2 rows)

-- Verify correctness against the bitmap fallback.
SET enable_mdam = off;
SET enable_bitmapscan = on;
SELECT count(*) AS expect FROM mdam_paper_tbl
WHERE ((dept = 1 AND sdate = '1995-03-04' AND item_class = 4)
    OR (dept = 50 AND sdate = '1995-09-04'))
  AND item_class = 5;
 expect 
--------
      0
(1 row)

SET enable_mdam = on;
SET enable_bitmapscan = off;
SELECT count(*) AS actual FROM mdam_paper_tbl
WHERE ((dept = 1 AND sdate = '1995-03-04' AND item_class = 4)
    OR (dept = 50 AND sdate = '1995-09-04'))
  AND item_class = 5;
 actual 
--------
      0
(1 row)

DROP TABLE mdam_paper_tbl;
--
-- Shattering truncation: the cross-product of per-column critical points
-- (a={3,5,13,65,89,96}, b={50}, c={25}, d={3,6,9,14,21,23} -> 13 x 3 x 3 x
-- 13 = 1521 elementary intervals) exceeds MDAM_MAX_RETRIEVALS (256), so
-- mdam_generate_recursive must mark ctx->retrievals_truncated and bail
-- rather than emit a partial Append.  The planner therefore falls back to
-- BitmapOr (or another non-MDAM path that covers the whole predicate).
--
SET enable_bitmapscan = on;
EXPLAIN (COSTS OFF)
SELECT count(*) FROM mdam_test_tbl
WHERE (a IN (3, 5, 13, 65, 89) AND b = 50 AND c = 25
       AND d IN (3, 6, 9, 14, 21, 23))
   OR (a < 96 AND b >= 50);
                                                                              QUERY PLAN                                                                               
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Aggregate
   ->  Bitmap Heap Scan on mdam_test_tbl
         Recheck Cond: (((a = ANY ('{3,5,13,65,89}'::integer[])) AND (b = 50) AND (c = 25) AND (d = ANY ('{3,6,9,14,21,23}'::integer[]))) OR ((a < 96) AND (b >= 50)))
         ->  BitmapOr
               ->  Bitmap Index Scan on mdam_test_tbl_idx
                     Index Cond: ((a = ANY ('{3,5,13,65,89}'::integer[])) AND (b = 50) AND (c = 25) AND (d = ANY ('{3,6,9,14,21,23}'::integer[])))
               ->  Bitmap Index Scan on mdam_test_tbl_idx
                     Index Cond: ((a < 96) AND (b >= 50))
(8 rows)

SET enable_mdam = off;
SELECT count(*) AS expect FROM mdam_test_tbl
WHERE (a IN (3, 5, 13, 65, 89) AND b = 50 AND c = 25
       AND d IN (3, 6, 9, 14, 21, 23))
   OR (a < 96 AND b >= 50);
 expect 
--------
  48000
(1 row)

SET enable_mdam = on;
SELECT count(*) AS actual FROM mdam_test_tbl
WHERE (a IN (3, 5, 13, 65, 89) AND b = 50 AND c = 25
       AND d IN (3, 6, 9, 14, 21, 23))
   OR (a < 96 AND b >= 50);
 actual 
--------
  48000
(1 row)

SET enable_bitmapscan = off;
--
-- Two-arm OR where one arm is silent on the leading index column.  Index
-- is (q, p, s, r); arm 1 constrains q, arm 2 constrains only p.  With
-- NULLs in q, the shattered partition over q must include an explicit
-- (q IS NULL) sub-path so the open arm's non-leading quals
-- (p < 42 AND r >= 5) still match rows where q IS NULL.  The expected
-- plan is an Append whose sub-paths cover (q<95), (q=95), (q>95) and
-- (q IS NULL) for the open arm, plus the additional p/r stripes for the
-- shared (q=95) partition.
--
CREATE TABLE mdam_fuzz_tbl (p int, q int, r int, s int);
INSERT INTO mdam_fuzz_tbl
SELECT NULLIF((i*13+7) % 80, 0), NULLIF((i*7+3) % 100, 0),
       NULLIF((i*11+5) % 60, 0), NULLIF((i*3+11) % 30, 0)
FROM generate_series(1, 100000) i;
CREATE INDEX mdam_fuzz_qpsr ON mdam_fuzz_tbl(q, p, s, r);
ANALYZE mdam_fuzz_tbl;
SET enable_bitmapscan = on;
SET enable_mdam = off;
SELECT count(*) AS expect FROM mdam_fuzz_tbl
WHERE ((q = 95 AND r >= 54) OR (p < 42 AND r >= 5));
 expect 
--------
  46666
(1 row)

SET enable_mdam = on;
SET enable_bitmapscan = off;
SET enable_indexonlyscan = off;
EXPLAIN (COSTS OFF)
SELECT count(*) FROM mdam_fuzz_tbl
WHERE ((q = 95 AND r >= 54) OR (p < 42 AND r >= 5));
                             QUERY PLAN                             
--------------------------------------------------------------------
 Aggregate
   ->  Append
         ->  Index Scan using mdam_fuzz_qpsr on mdam_fuzz_tbl
               Index Cond: ((q < 95) AND (p < 42) AND (r >= 5))
         ->  Index Scan using mdam_fuzz_qpsr on mdam_fuzz_tbl
               Index Cond: ((q = 95) AND (p < 42) AND (r >= 5))
         ->  Index Scan using mdam_fuzz_qpsr on mdam_fuzz_tbl
               Index Cond: ((q = 95) AND (p >= 42) AND (r >= 54))
         ->  Index Scan using mdam_fuzz_qpsr on mdam_fuzz_tbl
               Index Cond: ((q = 95) AND (p IS NULL) AND (r >= 54))
         ->  Index Scan using mdam_fuzz_qpsr on mdam_fuzz_tbl
               Index Cond: ((q > 95) AND (p < 42) AND (r >= 5))
         ->  Index Scan using mdam_fuzz_qpsr on mdam_fuzz_tbl
               Index Cond: ((q IS NULL) AND (p < 42) AND (r >= 5))
(14 rows)

SELECT count(*) AS actual FROM mdam_fuzz_tbl
WHERE ((q = 95 AND r >= 54) OR (p < 42 AND r >= 5));
 actual 
--------
  46666
(1 row)

RESET enable_indexonlyscan;
DROP TABLE mdam_fuzz_tbl;
--
-- Inherent MDAM limitation: two arms whose shattered partitions share
-- a common leading-column stripe but disagree on the trailing column.
--   (a < 70 AND b = 19) OR (a > 53 AND b >= 68)
-- Critical points on a are {53, 70}.  The cleanest Append MDAM could
-- produce is four sub-paths:
--   (a <= 53,    b = 19)
--   (a in (53, 70), b = 19)
--   (a in (53, 70), b >= 68)
--   (a >= 70,    b >= 68)
-- but sub-paths 2 and 3 share the (53, 70) a-stripe.  Append concatenates
-- (it can't interleave), so sub-path 2 emits its full stripe before
-- sub-path 3 starts and a "rewinds" from 69 to 54 at the boundary -- a
-- key-space ordering violation no Append shape can fix.  MDAM must
-- detect the rewind via the post-coalesce ordering check and bail, so
-- the planner falls back to BitmapOr.
--
CREATE TABLE mdam_open_arm_tbl (a int, b int);
INSERT INTO mdam_open_arm_tbl
SELECT i % 100, i % 80 FROM generate_series(1, 10000) i;
CREATE INDEX mdam_open_arm_tbl_idx ON mdam_open_arm_tbl (a, b);
ANALYZE mdam_open_arm_tbl;
SET enable_bitmapscan = on;
EXPLAIN (COSTS OFF)
SELECT * FROM mdam_open_arm_tbl
WHERE (a < 70 AND b = 19) OR (a > 53 AND b >= 68);
                              QUERY PLAN                               
-----------------------------------------------------------------------
 Bitmap Heap Scan on mdam_open_arm_tbl
   Recheck Cond: (((a < 70) AND (b = 19)) OR ((a > 53) AND (b >= 68)))
   ->  BitmapOr
         ->  Bitmap Index Scan on mdam_open_arm_tbl_idx
               Index Cond: ((a < 70) AND (b = 19))
         ->  Bitmap Index Scan on mdam_open_arm_tbl_idx
               Index Cond: ((a > 53) AND (b >= 68))
(7 rows)

-- Coverage check: row counts match the bitmap fallback.
SET enable_mdam = off;
SELECT count(*) AS expect FROM mdam_open_arm_tbl
WHERE (a < 70 AND b = 19) OR (a > 53 AND b >= 68);
 expect 
--------
    825
(1 row)

SET enable_mdam = on;
SELECT count(*) AS actual FROM mdam_open_arm_tbl
WHERE (a < 70 AND b = 19) OR (a > 53 AND b >= 68);
 actual 
--------
    825
(1 row)

SET enable_bitmapscan = off;
DROP TABLE mdam_open_arm_tbl;
--
-- MDAM must not place a scan key on a column that the original arm
-- never constrained.  When another arm forces a critical point on
-- column k inside an overlapping leading-column partition, shattering
-- the silent arm into {k<v, k=v, k>v} applies a strict operator on k
-- that the original arm never wrote, dropping rows where k IS NULL.
--   (p = 70 AND r > 11 AND s > 12)
--     OR
--   (p > 61 AND q = 5 AND r > 49 AND s <= 20)
-- Arm 1 is silent on q.  Arm 2's q = 5 is the only critical point on
-- q, and the p = 70 partition is shared by both arms with disjoint
-- r/s constraints, so MDAM must either include an explicit
-- (q IS NULL) sub-path for arm 1's portion of the p = 70 stripe or
-- bail.  The current plan bails to BitmapOr; row counts then match
-- the bitmap reference regardless.
--
CREATE TABLE mdam_open_col_tbl (p int, q int, r int, s int);
INSERT INTO mdam_open_col_tbl
SELECT NULLIF((i*13+7) % 80, 0), NULLIF((i*7+3) % 100, 0),
       NULLIF((i*11+5) % 60, 0), NULLIF((i*3+11) % 30, 0)
FROM generate_series(1, 100000) i;
CREATE INDEX mdam_open_col_tbl_idx ON mdam_open_col_tbl (p, q, r, s);
ANALYZE mdam_open_col_tbl;
-- Plan check: MDAM bails; planner falls back to BitmapOr.
SET enable_bitmapscan = on;
EXPLAIN (COSTS OFF)
SELECT * FROM mdam_open_col_tbl
WHERE (p = 70 AND r > 11 AND s > 12)
   OR (p > 61 AND q = 5 AND r > 49 AND s <= 20);
                                                 QUERY PLAN                                                  
-------------------------------------------------------------------------------------------------------------
 Bitmap Heap Scan on mdam_open_col_tbl
   Recheck Cond: (((p = 70) AND (r > 11) AND (s > 12)) OR ((p > 61) AND (q = 5) AND (r > 49) AND (s <= 20)))
   ->  BitmapOr
         ->  Bitmap Index Scan on mdam_open_col_tbl_idx
               Index Cond: ((p = 70) AND (r > 11) AND (s > 12))
         ->  Bitmap Index Scan on mdam_open_col_tbl_idx
               Index Cond: ((p > 61) AND (q = 5) AND (r > 49) AND (s <= 20))
(7 rows)

-- Coverage check: row count must match the bitmap reference.
SET enable_mdam = off;
SELECT count(*) AS expect FROM mdam_open_col_tbl
WHERE (p = 70 AND r > 11 AND s > 12)
   OR (p > 61 AND q = 5 AND r > 49 AND s <= 20);
 expect 
--------
    833
(1 row)

SET enable_mdam = on;
SET enable_bitmapscan = off;
SELECT count(*) AS actual FROM mdam_open_col_tbl
WHERE (p = 70 AND r > 11 AND s > 12)
   OR (p > 61 AND q = 5 AND r > 49 AND s <= 20);
 actual 
--------
    833
(1 row)

DROP TABLE mdam_open_col_tbl;
--
-- SAOP at the last constrained column of a path must be split into
-- individual EQ paths before sort.  Otherwise the SAOP's effective
-- sort interval [min, max] encloses an adjacent path whose range falls
-- between the SAOP's values, and Append concatenation emits the SAOP's
-- high endpoint before the enclosed range -- a key-space ordering
-- violation no Append can fix.
--   (a IN (10, 50)) OR (a >= 5 AND b = 25 AND c = 25)
-- Arm 1's SAOP is on the leading column a; arm 2 produces a (10, 50)
-- range stripe on a after shattering.  The expected Append has five
-- sub-paths: a in [5, 10), a = 10, a in (10, 50), a = 50, a > 50.
--
CREATE TABLE mdam_saop_tbl (a int, b int, c int, d int);
INSERT INTO mdam_saop_tbl
SELECT i / 1000, i % 100, i % 50, i % 25 FROM generate_series(1, 100000) i;
CREATE INDEX mdam_saop_tbl_idx ON mdam_saop_tbl (a, b, c, d);
ANALYZE mdam_saop_tbl;
EXPLAIN (COSTS OFF)
SELECT * FROM mdam_saop_tbl
WHERE (a IN (10, 50)) OR (a >= 5 AND b = 25 AND c = 25)
ORDER BY a, b, c, d;
                              QUERY PLAN                               
-----------------------------------------------------------------------
 Append
   ->  Index Only Scan using mdam_saop_tbl_idx on mdam_saop_tbl
         Index Cond: ((a >= 5) AND (a < 10) AND (b = 25) AND (c = 25))
   ->  Index Only Scan using mdam_saop_tbl_idx on mdam_saop_tbl
         Index Cond: (a = 10)
   ->  Index Only Scan using mdam_saop_tbl_idx on mdam_saop_tbl
         Index Cond: ((a > 10) AND (a < 50) AND (b = 25) AND (c = 25))
   ->  Index Only Scan using mdam_saop_tbl_idx on mdam_saop_tbl
         Index Cond: (a = 50)
   ->  Index Only Scan using mdam_saop_tbl_idx on mdam_saop_tbl
         Index Cond: ((a > 50) AND (b = 25) AND (c = 25))
(11 rows)

-- Ordering check: no row may have a strictly larger leading-col value
-- than the row immediately following it in the Append's output.
SELECT count(*) AS misordered_pairs FROM (
    SELECT a, lead(a) OVER () AS next_a FROM mdam_saop_tbl
    WHERE (a IN (10, 50)) OR (a >= 5 AND b = 25 AND c = 25)
) sub
WHERE next_a IS NOT NULL AND next_a < a;
 misordered_pairs 
------------------
                0
(1 row)

-- Coverage check: row counts match the bitmap fallback.
SET enable_mdam = off;
SET enable_bitmapscan = on;
SELECT count(*) AS expect FROM mdam_saop_tbl
WHERE (a IN (10, 50)) OR (a >= 5 AND b = 25 AND c = 25);
 expect 
--------
   2930
(1 row)

SET enable_mdam = on;
SET enable_bitmapscan = off;
SELECT count(*) AS actual FROM mdam_saop_tbl
WHERE (a IN (10, 50)) OR (a >= 5 AND b = 25 AND c = 25);
 actual 
--------
   2930
(1 row)

--
-- A contradictory OR arm with EQ + SAOP on the same column (here
-- b = 50 AND b IN (10, 80)) must not be silently widened by step 4
-- expand/sort/coalesce.  The extract_interval -> interval_to_atoms
-- round-trip used by the multi-atom Range branch collapses a SAOP to
-- its [min, max] hull; if that hull contains the conflicting EQ value
-- the intersection looks non-empty and the SAOP vanishes from the
-- resulting index quals, admitting rows the original predicate
-- excluded.  Both atoms must survive verbatim so nbtree's runtime
-- _bt_preprocess_keys detects the inconsistency.
--
-- With b = 25 here, b = 25 AND b = ANY ('{10,80}') is impossible, so
-- nbtree short-circuits to zero rows -- matching the bitmap oracle
-- below.
SET enable_mdam = on;
SET enable_bitmapscan = off;
