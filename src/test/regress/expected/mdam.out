--
-- Ordering check must reject Append shapes where two sub-paths' intervals
-- strictly overlap on any column at first_diff (where their sort keys
-- diverge), not just on the leading column.  The merge step can coalesce
-- one conjunct's stripes into a wider range when they share the same
-- atoms on the other columns; another conjunct that pinned that column
-- with disjoint later-column atoms now lives "inside" the wider range,
-- and Append concatenation emits one full sub-path before the other --
-- "rewinding" the column at the boundary.
--
-- Two cases below.  The first has the divergence at the leading column;
-- the second pins a = 10 in two arms (so first_diff = 1, the non-leading
-- b column) but their b intervals strictly overlap.
--
CREATE TABLE mdam_overlap_tbl (a int, b int, c int, d int);
INSERT INTO mdam_overlap_tbl
SELECT (i / 1000) % 30, (i / 13) % 100, (i / 17) % 50, (i / 19) % 25
FROM generate_series(1, 200000) i;
CREATE INDEX mdam_overlap_tbl_idx ON mdam_overlap_tbl (a, b, c, d);
ANALYZE mdam_overlap_tbl;
-- (a) Leading-column overlap.
EXPLAIN (COSTS OFF)
SELECT * FROM mdam_overlap_tbl
WHERE ((a < 37 AND b IN (26, 28, 33, 80) AND c > 10)
    OR (a > 11 AND b >= 81 AND c > 27))
ORDER BY a, b, c, d;
                                                       QUERY PLAN                                                        
-------------------------------------------------------------------------------------------------------------------------
 Index Only Scan using mdam_overlap_tbl_idx on mdam_overlap_tbl
   Filter: (((a < 37) AND (b = ANY ('{26,28,33,80}'::integer[])) AND (c > 10)) OR ((a > 11) AND (b >= 81) AND (c > 27)))
(2 rows)

SET enable_mdam = off;
SET enable_bitmapscan = on;
SELECT count(*) AS expect FROM mdam_overlap_tbl
WHERE ((a < 37 AND b IN (26, 28, 33, 80) AND c > 10)
    OR (a > 11 AND b >= 81 AND c > 27));
 expect 
--------
  16294
(1 row)

SET enable_mdam = on;
SET enable_bitmapscan = off;
SELECT count(*) AS actual FROM mdam_overlap_tbl
WHERE ((a < 37 AND b IN (26, 28, 33, 80) AND c > 10)
    OR (a > 11 AND b >= 81 AND c > 27));
 actual 
--------
  16294
(1 row)

-- (b) Non-leading-column overlap: a=10 in two arms, b intervals
-- (-inf, 50) and (30, +inf) overlap on (30, 50) with disjoint c
-- atoms.  A third arm (a=20...) keeps the planner from factoring
-- a=10 out of the OR.
EXPLAIN (COSTS OFF)
SELECT * FROM mdam_overlap_tbl
WHERE ((a = 10 AND b < 50 AND c < 10 AND d > 2)
    OR (a = 10 AND b > 30 AND c >= 20 AND d > 3)
    OR (a = 20 AND b > 5 AND c < 5))
ORDER BY a, b, c, d;
                                                                       QUERY PLAN                                                                        
---------------------------------------------------------------------------------------------------------------------------------------------------------
 Index Only Scan using mdam_overlap_tbl_idx on mdam_overlap_tbl
   Filter: (((a = 10) AND (b < 50) AND (c < 10) AND (d > 2)) OR ((a = 10) AND (b > 30) AND (c >= 20) AND (d > 3)) OR ((a = 20) AND (b > 5) AND (c < 5)))
(2 rows)

SET enable_mdam = off;
SET enable_bitmapscan = on;
SELECT count(*) AS expect FROM mdam_overlap_tbl
WHERE ((a = 10 AND b < 50 AND c < 10 AND d > 2)
    OR (a = 10 AND b > 30 AND c >= 20 AND d > 3)
    OR (a = 20 AND b > 5 AND c < 5));
 expect 
--------
   3254
(1 row)

SET enable_mdam = on;
SET enable_bitmapscan = off;
SELECT count(*) AS actual FROM mdam_overlap_tbl
WHERE ((a = 10 AND b < 50 AND c < 10 AND d > 2)
    OR (a = 10 AND b > 30 AND c >= 20 AND d > 3)
    OR (a = 20 AND b > 5 AND c < 5));
 actual 
--------
   3254
(1 row)

DROP TABLE mdam_overlap_tbl;
--
-- A contradictory cross-product conjunct (whose per-column intersection
-- of SAOP and EQ atoms is empty) is stashed in ctx->contradictory and
-- re-emitted as a standalone retrieval so the Append stays in 1:1
-- correspondence with the original OR's arms; nbtree's
-- _bt_preprocess_keys then short-circuits the contradiction at runtime.
-- Step 3 merge must not pass such a retrieval through
-- mdam_extract_interval, which would collapse a SAOP to its closed
-- [min, max] range and silently lose the discrete value constraint,
-- producing an over-broad index condition.
--
--   (a IN (3, 8, 15) AND b <= 10 AND c IN (1, 5, 9) AND c = 2)
--     OR
--   (a >= 20 AND b IN (5, 15, 25) AND c = 2)
-- Arm 1's c constraints intersect to empty.
--
EXPLAIN (COSTS OFF)
SELECT * FROM mdam_test_tbl
WHERE (a IN (3, 8, 15) AND b <= 10 AND c IN (1, 5, 9) AND c = 2)
   OR (a >= 20 AND b IN (5, 15, 25) AND c = 2);
                                    QUERY PLAN                                     
-----------------------------------------------------------------------------------
 Append
   ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
         Index Cond: ((a = 20) AND (b = ANY ('{5,15,25}'::integer[])) AND (c = 2))
   ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
         Index Cond: ((a > 20) AND (b = ANY ('{5,15,25}'::integer[])) AND (c = 2))
(5 rows)

-- Coverage check: the contradictory arm contributes zero rows; arm 2's
-- (a >= 20, b in {5,15,25}, c = 2) is also empty for this data because
-- b in {5,15,25} forces c in {5,15,25} (b = i%100, c = i%50), so the
-- correct count is zero.
SET enable_mdam = off;
SET enable_bitmapscan = on;
SELECT count(*) AS expect FROM mdam_test_tbl
WHERE (a IN (3, 8, 15) AND b <= 10 AND c IN (1, 5, 9) AND c = 2)
   OR (a >= 20 AND b IN (5, 15, 25) AND c = 2);
 expect 
--------
      0
(1 row)

SET enable_mdam = on;
SET enable_bitmapscan = off;
SELECT count(*) AS actual FROM mdam_test_tbl
WHERE (a IN (3, 8, 15) AND b <= 10 AND c IN (1, 5, 9) AND c = 2)
   OR (a >= 20 AND b IN (5, 15, 25) AND c = 2);
 actual 
--------
      0
(1 row)

--
-- Only 2+ key column indexes qualify: single-column index should not trigger MDAM
--
CREATE TABLE mdam_single_col_tbl (x int);
CREATE INDEX ON mdam_single_col_tbl (x);
INSERT INTO mdam_single_col_tbl SELECT i FROM generate_series(1, 1000) i;
ANALYZE mdam_single_col_tbl;
EXPLAIN (COSTS OFF)
SELECT * FROM mdam_single_col_tbl WHERE x = 1 OR x = 5;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Index Only Scan using mdam_single_col_tbl_x_idx on mdam_single_col_tbl
   Index Cond: (x = ANY ('{1,5}'::integer[]))
(2 rows)

DROP TABLE mdam_single_col_tbl;
--
-- Prepared statements: MDAM requires constant operands for its rewrite, so
-- generic plans (which use Param nodes instead of Const) must not produce
-- MDAM paths.  Force plan_cache_mode = force_generic_plan so we reliably
-- get the generic plan rather than a custom plan that still has constants.
--
SET plan_cache_mode = force_generic_plan;
PREPARE mdam_prep(int, int, int, int) AS
SELECT * FROM mdam_test_tbl
WHERE (a = $1 AND c = $2) OR (a = $3 AND b = $4);
EXPLAIN (COSTS OFF) EXECUTE mdam_prep(5, 10, 10, 20);
                           QUERY PLAN                           
----------------------------------------------------------------
 Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
   Filter: (((a = $1) AND (c = $2)) OR ((a = $3) AND (b = $4)))
(2 rows)

DEALLOCATE mdam_prep;
RESET plan_cache_mode;
--
-- Backward scan: ORDER BY ... DESC should use backward index scan
-- without an explicit Sort node, by reversing disjunct order and
-- scanning each sub-path in BackwardScanDirection.
--
EXPLAIN (COSTS OFF)
SELECT * FROM mdam_test_tbl
WHERE (a = 5 AND c = 10) OR (a = 10 AND b = 20)
ORDER BY a DESC, b DESC, c DESC, d DESC;
