--
-- MDAM paper example (simplified to 4-column int index).
-- Deeply nested AND/OR with IN lists and ranges -- the flagship test.
--
-- Original predicate:
--   ((c = 10 AND b BETWEEN 4 AND 25) OR a IN (2, 4, 5))
--   AND
--   ((a = 4 AND c = 5) OR (c IN (5, 10) AND (b = 4 OR a = 2)))
--
EXPLAIN (COSTS OFF)
SELECT * FROM mdam_test_tbl
WHERE ((c = 10 AND b >= 4 AND b <= 25) OR a IN (2, 4, 5))
  AND ((a = 4 AND c = 5) OR (c IN (5, 10) AND (b = 4 OR a = 2)));
                                  QUERY PLAN                                   
-------------------------------------------------------------------------------
 Append
   ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
         Index Cond: ((a < 2) AND (b = 4) AND (c = 10))
   ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
         Index Cond: ((a = 2) AND (c = ANY ('{5,10}'::integer[])))
   ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
         Index Cond: ((a > 2) AND (a < 4) AND (b = 4) AND (c = 10))
   ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
         Index Cond: ((a = 4) AND (b < 4) AND (c = 5))
   ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
         Index Cond: ((a = 4) AND (b = 4) AND (c = ANY ('{5,10}'::integer[])))
   ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
         Index Cond: ((a = 4) AND (b > 4) AND (c = 5))
   ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
         Index Cond: ((a = 4) AND (b IS NULL) AND (c = 5))
   ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
         Index Cond: ((a > 4) AND (a < 5) AND (b = 4) AND (c = 10))
   ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
         Index Cond: ((a = 5) AND (b = 4) AND (c = ANY ('{5,10}'::integer[])))
   ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
         Index Cond: ((a > 5) AND (b = 4) AND (c = 10))
   ->  Index Only Scan using mdam_test_tbl_idx on mdam_test_tbl
         Index Cond: ((a IS NULL) AND (b = 4) AND (c = 10))
(23 rows)

-- Verify correctness
SET enable_mdam = off;
SET enable_bitmapscan = on;
SELECT count(*) AS expect FROM mdam_test_tbl
WHERE ((c = 10 AND b >= 4 AND b <= 25) OR a IN (2, 4, 5))
  AND ((a = 4 AND c = 5) OR (c IN (5, 10) AND (b = 4 OR a = 2)));
 expect 
--------
     60
(1 row)

SET enable_mdam = on;
SET enable_bitmapscan = off;
SELECT count(*) AS actual FROM mdam_test_tbl
WHERE ((c = 10 AND b >= 4 AND b <= 25) OR a IN (2, 4, 5))
  AND ((a = 4 AND c = 5) OR (c IN (5, 10) AND (b = 4 OR a = 2)));
 actual 
--------
     60
(1 row)

--
-- Date column type: MDAM must handle non-integer types correctly.
--
CREATE TABLE mdam_date_tbl (dept int, sdate date, item_class int, store int);
INSERT INTO mdam_date_tbl
  SELECT i/100, '1995-01-01'::date + (i % 400), i % 75, i % 300
  FROM generate_series(1, 100000) i;
CREATE INDEX mdam_date_tbl_idx ON mdam_date_tbl(dept, sdate, item_class, store);
ANALYZE mdam_date_tbl;
-- MDAM paper flagship query shape (adapted for date column).
EXPLAIN (COSTS OFF)
SELECT * FROM mdam_date_tbl
WHERE ((item_class = 10 AND sdate >= '1995-06-04' AND sdate <= '1995-06-25')
       OR dept IN (2, 4, 5))
  AND ((dept = 4 AND item_class = 5)
       OR (item_class IN (5, 10) AND (sdate = '1995-06-04' OR dept = 2)));
                                                   QUERY PLAN                                                   
----------------------------------------------------------------------------------------------------------------
 Append
   ->  Index Only Scan using mdam_date_tbl_idx on mdam_date_tbl
         Index Cond: ((dept < 2) AND (sdate = '06-04-1995'::date) AND (item_class = 10))
   ->  Index Only Scan using mdam_date_tbl_idx on mdam_date_tbl
         Index Cond: ((dept = 2) AND (item_class = ANY ('{5,10}'::integer[])))
   ->  Index Only Scan using mdam_date_tbl_idx on mdam_date_tbl
         Index Cond: ((dept > 2) AND (dept < 4) AND (sdate = '06-04-1995'::date) AND (item_class = 10))
   ->  Index Only Scan using mdam_date_tbl_idx on mdam_date_tbl
         Index Cond: ((dept = 4) AND (sdate < '06-04-1995'::date) AND (item_class = 5))
   ->  Index Only Scan using mdam_date_tbl_idx on mdam_date_tbl
         Index Cond: ((dept = 4) AND (sdate = '06-04-1995'::date) AND (item_class = ANY ('{5,10}'::integer[])))
   ->  Index Only Scan using mdam_date_tbl_idx on mdam_date_tbl
         Index Cond: ((dept = 4) AND (sdate > '06-04-1995'::date) AND (item_class = 5))
   ->  Index Only Scan using mdam_date_tbl_idx on mdam_date_tbl
         Index Cond: ((dept = 4) AND (sdate IS NULL) AND (item_class = 5))
   ->  Index Only Scan using mdam_date_tbl_idx on mdam_date_tbl
         Index Cond: ((dept > 4) AND (dept < 5) AND (sdate = '06-04-1995'::date) AND (item_class = 10))
   ->  Index Only Scan using mdam_date_tbl_idx on mdam_date_tbl
         Index Cond: ((dept = 5) AND (sdate = '06-04-1995'::date) AND (item_class = ANY ('{5,10}'::integer[])))
   ->  Index Only Scan using mdam_date_tbl_idx on mdam_date_tbl
         Index Cond: ((dept > 5) AND (sdate = '06-04-1995'::date) AND (item_class = 10))
   ->  Index Only Scan using mdam_date_tbl_idx on mdam_date_tbl
         Index Cond: ((dept IS NULL) AND (sdate = '06-04-1995'::date) AND (item_class = 10))
(23 rows)

