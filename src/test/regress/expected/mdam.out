   ->  Index Only Scan Backward using mdam_test_tbl_idx on mdam_test_tbl
         Index Cond: ((a = 10) AND (b = 20))
   ->  Index Only Scan Backward using mdam_test_tbl_idx on mdam_test_tbl
         Index Cond: ((a = 5) AND (c = 10))
(5 rows)

SELECT a, b, c, d FROM mdam_test_tbl
WHERE (a = 5 AND c = 10) OR (a = 10 AND b = 20)
ORDER BY a DESC, b DESC, c DESC, d DESC;
