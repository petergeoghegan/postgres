SELECT count(*) AS actual FROM mdam_null_bug_tbl
WHERE (b > 50 AND b IS NOT NULL) OR a = 7;
 actual 
--------
  69386
(1 row)

-- Case E: degenerate "true for every row" -- IS NULL OR IS NOT NULL on
