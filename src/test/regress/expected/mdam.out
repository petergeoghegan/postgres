--
-- Value-bounded inputs whose union spans (-inf, +inf) must not merge to
-- "no scan key on column" when the original predicate excludes NULL.
--
-- Each case below has an OR with two arms whose bounded constraints on
-- the same column together cover every non-NULL value (e.g. b < 100 OR
-- b > 50).  Merging them into an unconstrained interval would emit an
-- Index Scan with no scan key on the column, admitting rows where that
-- column is NULL that the original predicate excludes.
-- merge_interval_list splits at the overlap boundary; step 4c only
-- re-consolidates when a sibling IS NULL path explicitly grants NULL
-- coverage.  Tables have NULLs in the relevant columns so any failure
-- mode shows up as extra rows vs. the bitmap baseline.
--
CREATE TABLE mdam_null_bug_tbl (a int, b int, c int);
INSERT INTO mdam_null_bug_tbl
SELECT i % 50,
       CASE WHEN i % 13 = 0 THEN NULL ELSE (i * 7) % 200 END,
       i % 25
FROM generate_series(1, 100000) i;
CREATE INDEX mdam_null_bug_idx ON mdam_null_bug_tbl (a, b, c);
ANALYZE mdam_null_bug_tbl;
--
-- Case 1: two arms with the same leading-column key and complementary b
-- ranges that together cover all non-NULL b, plus a third arm to push
-- MDAM past the cost threshold so the Append is actually chosen.  The
-- two (a = 5) retrievals collapse into a single (a = 5) AND (b IS NOT
-- NULL) scan rather than coalescing to an unconstrained "any b" scan
-- that would admit a = 5 AND b IS NULL rows.
--
SET enable_mdam = off;
SET enable_bitmapscan = on;
EXPLAIN (COSTS OFF)
SELECT count(*) FROM mdam_null_bug_tbl
WHERE (a = 5 AND b < 100) OR (a = 5 AND b > 50) OR (a = 10 AND c = 0);
                                             QUERY PLAN                                              
-----------------------------------------------------------------------------------------------------
 Aggregate
   ->  Bitmap Heap Scan on mdam_null_bug_tbl
         Recheck Cond: (((a = 5) AND (b < 100)) OR ((a = 5) AND (b > 50)) OR ((a = 10) AND (c = 0)))
         ->  BitmapOr
               ->  Bitmap Index Scan on mdam_null_bug_idx
                     Index Cond: ((a = 5) AND (b < 100))
               ->  Bitmap Index Scan on mdam_null_bug_idx
                     Index Cond: ((a = 5) AND (b > 50))
               ->  Bitmap Index Scan on mdam_null_bug_idx
                     Index Cond: ((a = 10) AND (c = 0))
(10 rows)

SELECT count(*) AS expect FROM mdam_null_bug_tbl
WHERE (a = 5 AND b < 100) OR (a = 5 AND b > 50) OR (a = 10 AND c = 0);
 expect 
--------
   1846
(1 row)

SET enable_mdam = on;
SET enable_bitmapscan = off;
EXPLAIN (COSTS OFF)
SELECT count(*) FROM mdam_null_bug_tbl
WHERE (a = 5 AND b < 100) OR (a = 5 AND b > 50) OR (a = 10 AND c = 0);
                                QUERY PLAN                                
--------------------------------------------------------------------------
 Aggregate
   ->  Append
         ->  Index Only Scan using mdam_null_bug_idx on mdam_null_bug_tbl
               Index Cond: ((a = 5) AND (b IS NOT NULL))
         ->  Index Only Scan using mdam_null_bug_idx on mdam_null_bug_tbl
               Index Cond: ((a = 10) AND (c = 0))
(6 rows)

SELECT count(*) AS actual FROM mdam_null_bug_tbl
WHERE (a = 5 AND b < 100) OR (a = 5 AND b > 50) OR (a = 10 AND c = 0);
 actual 
--------
   1846
(1 row)

-- Data shape: report how many rows have a = 5 AND b IS NULL.  These rows
-- are excluded by the original predicate, so 'actual' above must not
-- include them; the count below quantifies the gap the b-range split is
-- preserving.
SELECT count(*) AS a5_null_b FROM mdam_null_bug_tbl
WHERE a = 5 AND b IS NULL;
 a5_null_b 
-----------
       154
(1 row)

--
-- Case 2: step 4c's IS NULL sibling logic.  Arm 1 is silent on b (so
-- shattering generates an IS NULL pseudo-interval for b), arm 2 pins
-- b = 20.  After step 4a re-shatters the silent arm's b column into
-- (b < 20), (b = 20), (b > 20), (b IS NULL), step 4c must recognise the
-- (b IS NULL) sibling when coalescing b <= 20 with b > 20, otherwise the
-- merge falls into the split branch and the Append stays at 4 retrievals
-- instead of 2.  The expected plan is the natural 2-arm Append matching
-- the original OR.
--
SET enable_mdam = off;
SET enable_bitmapscan = on;
EXPLAIN (COSTS OFF)
SELECT count(*) FROM mdam_null_bug_tbl
WHERE (a = 5 AND c = 10) OR (a = 10 AND b = 20);
                                QUERY PLAN                                 
---------------------------------------------------------------------------
 Aggregate
   ->  Bitmap Heap Scan on mdam_null_bug_tbl
         Recheck Cond: (((a = 5) AND (c = 10)) OR ((a = 10) AND (b = 20)))
         ->  BitmapOr
               ->  Bitmap Index Scan on mdam_null_bug_idx
                     Index Cond: ((a = 5) AND (c = 10))
               ->  Bitmap Index Scan on mdam_null_bug_idx
                     Index Cond: ((a = 10) AND (b = 20))
(8 rows)

SELECT count(*) AS expect FROM mdam_null_bug_tbl
WHERE (a = 5 AND c = 10) OR (a = 10 AND b = 20);
 expect 
--------
    461
(1 row)

SET enable_mdam = on;
SET enable_bitmapscan = off;
EXPLAIN (COSTS OFF)
SELECT count(*) FROM mdam_null_bug_tbl
WHERE (a = 5 AND c = 10) OR (a = 10 AND b = 20);
                                QUERY PLAN                                
--------------------------------------------------------------------------
 Aggregate
   ->  Append
         ->  Index Only Scan using mdam_null_bug_idx on mdam_null_bug_tbl
               Index Cond: ((a = 5) AND (c = 10))
         ->  Index Only Scan using mdam_null_bug_idx on mdam_null_bug_tbl
               Index Cond: ((a = 10) AND (b = 20))
(6 rows)

SELECT count(*) AS actual FROM mdam_null_bug_tbl
WHERE (a = 5 AND c = 10) OR (a = 10 AND b = 20);
