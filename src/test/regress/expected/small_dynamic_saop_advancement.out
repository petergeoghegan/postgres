-- Just about the smallest possible stress test that goes over 80 checks of
-- the same tuple for ongoing failures:
with a as (
  select i from generate_series(0, 8) i
)
select
  count(*), two, four, twenty
from
  tenk1_dyn_saop
where
  two = any (array[(select array_agg(i) from a)]) and
  four = any (array[(select array_agg(i) from a)]) and
  twenty = any (array[(select array_agg(i) from a)])
group by
  two, four, twenty
order by
  two, four, twenty;
 count | two | four | twenty 
-------+-----+------+--------
   500 |   0 |    0 |      0
   500 |   0 |    0 |      4
   500 |   0 |    0 |      8
   500 |   0 |    2 |      2
   500 |   0 |    2 |      6
   500 |   1 |    1 |      1
   500 |   1 |    1 |      5
   500 |   1 |    3 |      3
   500 |   1 |    3 |      7
(9 rows)

-- Minimal variant that fails independently due to infinite looping:
with a as (
  select i from generate_series(0, 85) i
)
select
  count(*), two, four, twenty
from
  tenk1_dyn_saop
where
  two = any (array[(select array_agg(i) from a)]) and
  four = any (array[(select array_agg(i) from a)]) and
  twenty = any (array[(select array_agg(i) from a)])
group by
  two, four, twenty
order by
  two, four, twenty;
 count | two | four | twenty 
-------+-----+------+--------
   500 |   0 |    0 |      0
   500 |   0 |    0 |      4
   500 |   0 |    0 |      8
   500 |   0 |    0 |     12
   500 |   0 |    0 |     16
   500 |   0 |    2 |      2
   500 |   0 |    2 |      6
   500 |   0 |    2 |     10
   500 |   0 |    2 |     14
   500 |   0 |    2 |     18
   500 |   1 |    1 |      1
   500 |   1 |    1 |      5
   500 |   1 |    1 |      9
   500 |   1 |    1 |     13
   500 |   1 |    1 |     17
   500 |   1 |    3 |      3
   500 |   1 |    3 |      7
   500 |   1 |    3 |     11
   500 |   1 |    3 |     15
   500 |   1 |    3 |     19
(20 rows)

-- August 26
-- This one remains
with a as (
  select i from generate_series(0, 5000) i
)
select
  count(*), two, four, twenty
from
  tenk1_dyn_saop
where
  two = any (array[(select array_agg(i) from a)]) and
  four = any (array[(select array_agg(i) from a)]) and
  twenty = any (array[(select array_agg(i) from a)])
group by
  two, four, twenty
order by
  two, four, twenty;
 count | two  | four | twenty 
