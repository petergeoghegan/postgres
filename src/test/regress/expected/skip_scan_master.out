   ->  Bitmap Heap Scan on tenk1_skipscan  (cost=122.41..444.03 rows=500 width=8) (actual rows=1000 loops=1)
         Recheck Cond: ((four = ANY ('{1,2}'::integer[])) AND (twenty = ANY ('{1,2}'::integer[])))
         Heap Blocks: exact=321
         Buffers: shared hit=331
         ->  Bitmap Index Scan on tenk1_skipscan_two_four_twenty  (cost=0.00..122.28 rows=500 width=0) (actual rows=1000 loops=1)
               Index Cond: ((four = ANY ('{1,2}'::integer[])) AND (twenty = ANY ('{1,2}'::integer[])))
               Buffers: shared hit=10
(11 rows)

set enable_indexonlyscan=on;
-- Redundant attributes test related to bug where equality input keys
-- spuriously get their own skip input key:
select distinct two, four, twenty, hundred
from tenk1_skipscan
where
  four in (0, 1)
  and four in (1, 2)
  and twenty = 1
order by two, four, twenty;
